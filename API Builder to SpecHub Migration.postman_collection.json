  "item": [
    {
      "name": "Migrate API Builder",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Log migration start result",
              "const apiId = pm.iterationData.get(\"apiId\");",
              "console.log(\"Migration started for apiId: \" + apiId);",
              "console.log(\"Response status: \" + pm.response.status);",
              "console.log(\"Response body: \" + pm.response.text());",
              "",
              "// Save apiId to collection variable for use in \"Get migration status\"",
              "pm.collectionVariables.set(\"currentApiId\", pm.iterationData.get(\"apiId\"));",
              "",
              "// Check response status",
              "pm.test(\"Migration initiated successfully\", function () {",
              "    const success = pm.response.code === 200 || pm.response.code === 201 || pm.response.code === 202;",
              "    if (success) {",
              "        console.log(\"✅ Migration successfully initiated for apiId: \" + apiId);",
              "    } else {",
              "        console.log(\"❌ Migration failed to initiate for apiId: \" + apiId + \" | Status: \" + pm.response.code);",
              "    }",
              "    pm.expect(success).to.be.true;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Conditionally build request body based on iteration data",
              "const workspaceId = pm.iterationData.get(\"workspaceId\");",
              "const workspaceName = pm.iterationData.get(\"workspaceName\");",
              "",
              "let body;",
              "if (workspaceId) {",
              "    body = { workspaceId: workspaceId };",
              "} else if (workspaceName) {",
              "    body = { workspaceInfo: { name: workspaceName } };",
              "} else {",
              "    console.log(\"⚠️ Neither workspaceId nor workspaceName provided for apiId: \" + pm.iterationData.get(\"apiId\"));",
              "}",
              "",
              "if (body) {",
              "    pm.request.body.update({",
              "        mode: \"raw\",",
              "        raw: JSON.stringify(body),",
              "        options: { raw: { language: \"json\" } }",
              "    });",
              "    console.log(\"Request body set to: \" + JSON.stringify(body));",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
