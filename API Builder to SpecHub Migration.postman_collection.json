    {
      "name": "Get migration status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse response body",
              "const responseJson = pm.response.json();",
              "console.log(\"Migration status response: \" + JSON.stringify(responseJson));",
              "",
              "// Extract status field (check common field names)",
              "const status = (responseJson.status || responseJson.state || \"\").toLowerCase();",
              "const currentApiId = pm.collectionVariables.get(\"currentApiId\");",
              "",
              "console.log(\"Migration status for apiId \" + currentApiId + \": \" + status);",
              "",
              "// Retry counter logic to avoid infinite loops (max 10 retries)",
              "let retries = pm.collectionVariables.get(\"retryCount\") || 0;",
              "retries = parseInt(retries);",
              "",
              "if (status === \"pending\" || status === \"running\" || status === \"in_progress\") {",
              "    if (retries < 10) {",
              "        pm.collectionVariables.set(\"retryCount\", retries + 1);",
              "        console.log(\"⏳ Migration still in progress. Retry attempt: \" + (retries + 1) + \"/10 for apiId: \" + currentApiId + \". Waiting 2 seconds before retrying...\");",
              "        // 2-second delay before retrying",
              "        setTimeout(function () {}, 2000);",
              "        pm.execution.setNextRequest(\"Get migration status\");",
              "    } else {",
              "        pm.collectionVariables.set(\"retryCount\", 0);",
              "        console.log(\"⚠️ Max retries reached for apiId: \" + currentApiId + \". Moving to next iteration.\");",
              "    }",
              "} else if (status === \"completed\" || status === \"success\") {",
              "    pm.collectionVariables.set(\"retryCount\", 0);",
              "    console.log(\"✅ Migration completed successfully for apiId: \" + currentApiId);",
              "} else if (status === \"failed\" || status === \"error\") {",
              "    pm.collectionVariables.set(\"retryCount\", 0);",
              "    console.log(\"❌ Migration failed for apiId: \" + currentApiId + \" | Status: \" + status);",
              "} else {",
              "    pm.collectionVariables.set(\"retryCount\", 0);",
              "    console.log(\"ℹ️ Unknown migration status: \" + status + \" for apiId: \" + currentApiId);",
              "}",
              "",
              "pm.test(\"Migration status check\", function () {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
