              "}",
              "else {",
              "    console.log(\"You have reached the catch-all condition for APIs & Workspaces, exiting...\")",
              "    pm.execution.setNextRequest('Collect user information')",
              "}",
              "",
              "// long running count of requests made",
              "totalCounter += 1",
              "console.log(`Workspace roles processing count: ${pm.collectionVariables.get(\"rolesCounter\")} / ${apiInfo.length}`)",
              "pm.collectionVariables.set('totalCounter', parseInt(totalCounter))"
            ],
