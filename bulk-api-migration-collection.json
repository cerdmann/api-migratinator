    {
      "name": "Get and store API info",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let apiInfo = pm.collectionVariables.get(\"apiInfo\");",
              "let apiCounter = pm.collectionVariables.get('apiCounter')",
              "console.log(apiInfo[apiCounter]['apiId'])",
              "pm.collectionVariables.set('targetApi', apiInfo[apiCounter]['apiId'])"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let apiInfo = pm.collectionVariables.get(\"apiInfo\")",
              "let apiCounter = pm.collectionVariables.get('apiCounter')",
              "",
              "let res = pm.response.json()",
              "",
              "if (apiCounter < apiInfo.length-1) {",
              "    apiInfo[apiCounter].name = res.api.name ? res.api.name : `No name found for API ${res.api.id}`",
              "    apiInfo[apiCounter].summary = res.api.summary ? res.api.summary : `API ${res.api.id}\\n SUMMARY`",
              "    apiInfo[apiCounter].description = res.api.description ? res.api.description : `API ${res.api.id}\\n DESCRIPTION`",
              "    apiInfo[apiCounter].isPublic = res.api.isPublic ? res.api.isPublic : false // default to false",
              "    apiInfo[apiCounter].versions = res.api.versions ? res.api.versions : `No versions found for API ${res.api.id}`",
              "    pm.collectionVariables.set(\"apiInfo\", apiInfo)",
              "    pm.execution.setNextRequest(\"Get and store API info\")",
              "} else if (apiCounter >= apiInfo.length-1) {",
              "    apiInfo[apiCounter].name = res.api.name ? res.api.name : `No name found for API ${res.api.id}`",
              "    apiInfo[apiCounter].summary = res.api.summary ? res.api.summary : `Summary for API ${res.api.id}`",
              "    apiInfo[apiCounter].description = res.api.description ? res.api.description : `Description for API ${res.api.id}`",
              "    apiInfo[apiCounter].isPublic = res.api.isPublic ? res.api.isPublic : false // default to false",
              "    apiInfo[apiCounter].versions = res.api.versions ? res.api.versions : `No versions found for API ${res.api.id}`",
              "    pm.collectionVariables.set(\"apiInfo\", apiInfo)",
              "    console.log(res)",
              "    console.log(`Cycled through all available APIs, exiting...`)",
              "    pm.collectionVariables.set(\"apiCounter\", parseInt(0))",
              "    console.log(pm.collectionVariables.get(\"apiInfo\"))",
              "    pm.execution.setNextRequest(null)",
              "    return",
              "} else {",
              "    console.log(`Something went wrong: ${JSON.stringify(pm.response.json())}`)",
              "}",
              "",
              "pm.collectionVariables.set(\"apiCounter\", apiCounter += 1)"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
