              "}",
              "delayRequest();",
              "",
              "// USE THIS IF YOU WANT TO LIMIT BY SETS OF 10 API REQUESTS EVERY 10 SECONDS",
              "// if (rateLimitController < 10) {",
              "//     console.log(`Count: ${rateLimitController}`)",
              "// } else {",
              "//     setTimeout(() => {",
              "//         console.log(\"Pausing 8 seconds\");",
              "//     }, 8000);",
              "//     rateLimitController = 0;",
              "//     pm.collectionVariables.set('rateLimitController', rateLimitController)",
              "// }",
              "",
              "let targetWorkspaceId_updateRoles = apiInfo[rolesCounter].workspaceId",
              "",
              "pm.collectionVariables.set('targetWorkspaceId_updateRoles', targetWorkspaceId_updateRoles)",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let apiInfo = pm.collectionVariables.get(\"apiInfo\");",
              "let rolesCounter = pm.collectionVariables.get(\"rolesCounter\")",
              "let totalCounter = pm.collectionVariables.get('totalCounter')",
              "// ONLY NEEDED IF USING DYNAMIC RATE LIMIT LOGIC",
              "// let rateLimitController = pm.collectionVariables.get(\"rateLimitController\");",
              "// rateLimitController += 1;",
              "// pm.collectionVariables.set(\"rateLimitController\", rateLimitController);",
              "",
              "let res = pm.response.json().roles;",
              "",
              "if (rolesCounter < apiInfo.length - 1) {",
              "    apiInfo[rolesCounter].roles = res ? res : `Couldn't find roles for ${apiInfo[rolesCounter]}`",
              "    pm.collectionVariables.set(\"rolesCounter\", rolesCounter += 1);",
              "    pm.collectionVariables.set(\"apiInfo\", apiInfo);",
              "    pm.execution.setNextRequest('Get workspace roles')",
              "} else if (rolesCounter >= apiInfo.length - 1){",
              "    apiInfo[rolesCounter].roles = res ? res : `Couldn't find roles for ${apiInfo[rolesCounter]}`",
              "    pm.collectionVariables.set(\"rolesCounter\", rolesCounter += 1);",
              "    pm.collectionVariables.set(\"apiInfo\", apiInfo);",
              "    console.log(pm.collectionVariables.get(\"apiInfo\"))",
