              "// DELAY EACH REQUEST BY 1 SECOND TO AVOID RATE LIMITING OF 10 REQUESTS / 10 SECONDS TO /WORKSPACES ENDPOINT",
              "const delayRequest = () => {",
              "    console.log(\"Pausing 1 second\");",
