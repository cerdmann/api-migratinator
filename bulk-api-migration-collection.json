    {
      "name": "Get API Builder objects",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// initialize variables  ",
              "",
              "pm.collectionVariables.set('apiInfo', JSON.parse('[]'))",
              "pm.collectionVariables.set('workspacesToTag', JSON.parse('[]'))",
              "pm.collectionVariables.set('apiCounter', parseInt(0))",
              "pm.collectionVariables.set('workspaceCounter', parseInt(0))",
              "pm.collectionVariables.set('rateLimitController', parseInt(0))",
              "pm.collectionVariables.set('totalCounter', parseInt(0))",
              "pm.collectionVariables.set('rolesCounter', parseInt(0))",
              "pm.collectionVariables.set('workspacesInfo', JSON.parse('[]'))",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let apiInfo = pm.collectionVariables.get(\"apiInfo\");",
              "let apis = pm.response.json().apis;",
              "",
              "// build object for downstream output, per each API ",
              "apis.forEach(val => {",
              "    apiInfo.push({",
              "        apiId: val.id,",
              "        name: val.name,",
              "    })",
              "})",
              "",
              "pm.collectionVariables.set('apiInfo', apiInfo)",
              "",
              "// console.log(pm.collectionVariables.get('apiInfo'))"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.getpostman.com/apis",
          "protocol": "https",
          "host": [
            "api",
            "getpostman",
            "com"
          ],
          "path": [
            "apis"
          ]
        },
        "description": "Retrieves the list of API Builder APIs used as the source dataset for the mapping workflow. Run this first to populate API metadata and identify the records that need user lookups or validation."
      },
      "response": []
    },
    {
      "name": "Get and add workspace info",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let apiInfo = pm.collectionVariables.get(\"apiInfo\");",
              "let apiCounter = pm.collectionVariables.get(\"apiCounter\");",
              "// let rateLimitController = pm.collectionVariables.get(\"rateLimitController\"); // // ONLY NEEDED IF USING DYNAMIC RATE LIMIT LOGIC",
              "",
              "// DELAY EACH REQUEST BY 1 SECOND TO AVOID RATE LIMITING OF 10 REQUESTS / 10 SECONDS TO /WORKSPACES ENDPOINT",
              "const delayRequest = () => {",
              "    console.log(\"Pausing 1 second\");",
              "    setTimeout(() => {}, 1000);",
              "}",
              "delayRequest();",
              "",
              "// USE THIS IF YOU WANT TO LIMIT BY SETS OF 10 API REQUESTS EVERY 10 SECONDS",
              "// if (rateLimitController < 10) {",
              "//     console.log(`Count: ${rateLimitController}`)",
              "// } else {",
              "//     setTimeout(() => {",
              "//         console.log(\"Pausing 8 seconds\");",
              "//     }, 8000);",
              "//     rateLimitController = 0;",
              "//     pm.collectionVariables.set('rateLimitController', rateLimitController)",
              "// }",
              "",
              "",
              "let targetApiId = apiInfo[apiCounter].apiId",
              "pm.collectionVariables.set('targetApiId', targetApiId)",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let apiInfo = pm.collectionVariables.get(\"apiInfo\")",
              "let apiCounter = pm.collectionVariables.get(\"apiCounter\")",
              "let totalCounter = pm.collectionVariables.get('totalCounter')",
              "let workspacesToTag = pm.collectionVariables.get('workspacesToTag')",
              "let workspacesInfo = pm.collectionVariables.get('workspacesInfo')",
              "// ONLY NEEDED IF USING DYNAMIC RATE LIMIT LOGIC",
              "// let rateLimitController = pm.collectionVariables.get(\"rateLimitController\");",
              "// rateLimitController += 1;",
              "// pm.collectionVariables.set(\"rateLimitController\", rateLimitController);",
              "",
              "let res = pm.response.json().workspaces;",
              "",
              "if (apiCounter < apiInfo.length - 1) {",
              "    apiInfo[apiCounter].workspaceId = res[0].id ? res[0].id : `Couldn't find workspaceId for ${res[0].id}`",
              "    apiCounter += 1",
              "    workspacesToTag.push(res[0].id)",
              "    pm.collectionVariables.set(\"apiCounter\", apiCounter)",
              "    pm.collectionVariables.set(\"apiInfo\", apiInfo)",
              "    pm.collectionVariables.set(\"workspacesToTag\", workspacesToTag)",
              "    pm.collectionVariables.set(\"workspacesInfo\", workspacesInfo)",
              "    pm.execution.setNextRequest('Get and add workspace info')",
              "} else if (apiCounter >= apiInfo.length - 1){",
              "    apiInfo[apiCounter].workspaceId = res[0].id ? res[0].id : `Couldn't find workspaceId for ${res[0].id}`",
              "    workspacesToTag.push(res[0].id)",
              "    // remove duplicates from workspacesToTag array",
              "    let workspacesToTag_set = new Set(workspacesToTag)",
              "    // set back to array",
              "    workspacesToTag = Array.from(workspacesToTag_set)",
              "    pm.collectionVariables.set(\"workspacesToTag\", workspacesToTag)",
              "    pm.collectionVariables.set(\"apiInfo\", apiInfo);",
              "    console.log(\"All workspaces fetched, exiting...\")",
              "    pm.execution.setNextRequest('Tag original workspaces')",
              "}",
              "else {",
              "    console.log(\"You have reached the catch-all condition for APIs & Workspaces, exiting...\")",
              "    pm.execution.setNextRequest(null)",
              "}",
              "",
              "// long running count of requests made",
              "totalCounter += 1",
              "console.log(`API processing count: ${totalCounter} / ${apiInfo.length}`)",
              "pm.collectionVariables.set('totalCounter', parseInt(totalCounter))"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.getpostman.com/workspaces?elementType=api&elementId={{targetApiId}}",
          "protocol": "https",
          "host": [
            "api",
            "getpostman",
            "com"
          ],
          "path": [
            "workspaces"
          ],
          "query": [
            {
              "key": "elementType",
              "value": "api"
            },
            {
              "key": "elementId",
              "value": "{{targetApiId}}"
            }
          ]
        },
        "description": "### Estimated time per sets of API calls\n\nEach time you send this request, a 1 second delay occurs. This is built in to prevent rate limiting during Collection or Folder runs.\n\nThis accounts for the default rate limit on the `/workspaces` endpoint.\n\nIf your team has a high number of APIs in API Builder, you may want to start your run of the **Collection runner requests** folder while you need to do other tasks.\n\n- 10,000 API elements / \\~167 minutes\n    \n- 5,000 API elements / \\~84 minutes\n    \n- 1000 API elements / \\~17 minutes"
      },
      "response": []
    },
    {
      "name": "Tag original workspaces",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let workspaceCounter = pm.collectionVariables.get('workspaceCounter');",
              "let workspacesToTag = pm.collectionVariables.get('workspacesToTag');",
              "let apiInfo = pm.collectionVariables.get('apiInfo');",
              "// add logic to log errors if too many tags, bad formatting, etc.",
              "",
              "let res = pm.response.json();",
              "",
              "if (workspaceCounter < workspacesToTag.length - 1){",
              "    pm.collectionVariables.set('workspaceCounter', workspaceCounter + 1);",
              "    pm.execution.setNextRequest('Tag original workspaces');",
              "} else if (workspaceCounter >= workspacesToTag.length - 1) {",
              "    pm.collectionVariables.set('workspaceCounter', parseInt(0));",
              "    pm.collectionVariables.set('apiCounter', parseInt(0));",
              "    pm.execution.setNextRequest('Get workspace roles');",
              "    console.log(pm.collectionVariables.get('apiInfo'))",
              "} else {",
              "    console.log(`Something unexpected happened, breaking out of run...\\n response: ${JSON.stringify(res)}`)",
              "    pm.execution.setNextRequest(null);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let workspacesToTag = pm.collectionVariables.get('workspacesToTag');",
              "let workspaceCounter = pm.collectionVariables.get('workspaceCounter');",
              "",
              "let targetWorkspaceId_toTag = workspacesToTag[workspaceCounter]",
              "pm.collectionVariables.set('targetWorkspaceId_toTag', targetWorkspaceId_toTag)"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"tags\": [\n        {\n            \"slug\": \"pre-api-migration-workspace\"\n        }\n    ]\n}",
          "options": {
